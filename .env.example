# copy to .env and adjust; all keys are optional

# host port of the web service
SOLAR_PORT=8080

# default observer location (Garwolin, Poland): degrees (north and east positive), metres above sea level,
# display name
SOLAR_DEFAULT_LAT=51.897202
SOLAR_DEFAULT_LON=21.615002
SOLAR_DEFAULT_ELEV=100
SOLAR_DEFAULT_NAME=Garwolin
